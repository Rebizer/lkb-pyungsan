<main id="main">
    <h1 class="sr_only">법무법인 LKB평산</h1>
    <section class="home_hero">
        @* 배경 이미지 Swiper *@
        <div class="hero_image">
            <div class="hero_image_slider swiper" aria-hidden="true">
                <div class="swiper-wrapper">
                    <div class="swiper-slide hero_image_slide">
                        <img class="hero_background" src="/images/home/home_hero_bg.png" alt="서울 도심 전경" fetchpriority="high">
                    </div>
                    <div class="swiper-slide hero_image_slide">
                        <img class="hero_background" src="/images/home/home_hero_bg_2.png" alt="서울 도심 전경" fetchpriority="auto">
                    </div>
                </div>
            </div>
        </div>
        <div class="hero_inner container-md">
            @* 배너 텍스트 Swiper *@
            <div class="hero_text_slider swiper" aria-label="메인 배너">
                <div class="swiper-wrapper">
                    <div class="swiper-slide hero_text_slide">
                        <div class="hero_content">
                            <p class="hero_title">Always
                                The Best Choice</p>
                            <p class="hero_text">사건의 크기보다, 책임의 무게를 먼저 생각합니다.</p>
                        </div>
                    </div>
                    <div class="swiper-slide hero_text_slide">
                        <div class="hero_content">
                            <p class="hero_title">배너 제목을 
                            입력해 주세요.</p>
                            <p class="hero_text">배너 내용을 입력해 주세요.</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="hero_controls swiper_controls">
                <button type="button" class="hero_prev swiper_btn" aria-label="이전 배너">
                    <i class="svg_icon icon_left arrow_hero_icon">
                        <img src="/images/icon/arrow_hero_icon.svg" alt="" aria-hidden="true">
                    </i>
                </button>
                <div class="hero_index swiper_index"></div>
                <button type="button" class="hero_next swiper_btn" aria-label="다음 배너">
                    <i class="svg_icon arrow_hero_icon">
                        <img src="/images/icon/arrow_hero_icon.svg" alt="" aria-hidden="true">
                    </i>
                </button>
                <button type="button" class="autoplay_toggle hero_play" aria-label="배너 자동 재생 정지" aria-pressed="false">
                    <i class="play_state" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <a href="#home_news" class="scroll_hint">scroll down<span></span></a>
        <div class="hero_notice">
            <div class="container-lg">
                <div class="hero_news_slider swiper" aria-label="주요 법인소식">
                    <div class="swiper-wrapper">
                        @for (var i = 0; i < 4; i++)
                        {
                            <a class="swiper-slide hero_news_item" href="/news/detail">
                                <strong>법인소식</strong>
                                <span>[방송출연] 김희준 대표이사 kbc 광주방송 휴먼토크 &lt;호남호남인&gt; 출연</span>
                            </a>
                        }
                    </div>
                </div>
                <button type="button" class="autoplay_toggle hero_news_play" aria-label="소식 자동 재생 정지" aria-pressed="false">
                    <i class="play_state" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </section>
    <section id="home_news" class="home_news section">
        <div class="container-lg">
            <h2 class="english_heading section_scroll">NEWS</h2>
            <div class="section_heading section_scroll">
                <h3>언론보도</h3>
                <div class="slider_buttons swiper_controls">
                    <button type="button" class="press_prev swiper_btn" aria-label="이전 언론보도">
                        <i class="svg_icon arrow_hover_icon icon_left arrow_press_icon">
                            <img src="/images/icon/arrow_press_icon.svg" alt="" aria-hidden="true">
                        </i>
                    </button>
                    <div class="press_index swiper_index"></div>
                    <button type="button" class="press_next swiper_btn" aria-label="다음 언론보도">
                        <i class="svg_icon arrow_hover_icon arrow_press_icon">
                            <img src="/images/icon/arrow_press_icon.svg" alt="" aria-hidden="true">
                        </i>
                    </button>
                </div>
                <a class="button pc_button" href="/media">
                    언론보도 더보기
                    <i class="svg_icon arrow_hover_icon arrow_home_icon">
                        <img src="/images/icon/arrow_home_icon.svg" alt="" aria-hidden="true">
                    </i>
                </a>
            </div>
            <div class="press_slider swiper section_scroll">
                <ul class="swiper-wrapper">
                    @for (var i = 0; i < swiperWrapperItems1.Length; i++)
                    {
                        var item = swiperWrapperItems1[i];

                        <li class="swiper-slide">
                            <a href="/news/detail">
                                <div>
                                    <time class="post_date">26-00-00</time>
                                    <p class="post_title ellipsis line2">@item.Text</p>
                                </div>
                                <figure class="press_img">
                                    <img src="@item.Image" alt="@item.ImageDescription" loading="lazy">
                                </figure>
                            </a>
                        </li>
                    }
                </ul>
            </div>
            <a class="button m_button" href="/media">
                언론보도 더보기
                <i class="svg_icon arrow_hover_icon arrow_home_icon">
                    <img src="/images/icon/arrow_home_icon.svg" alt="" aria-hidden="true">
                </i>
            </a>
            <div class="section_heading corporate_heading section_scroll">
                <h3>법인소식</h3>
                <a class="button pc_button" href="/news">
                    소식 더보기
                    <i class="svg_icon arrow_hover_icon arrow_home_icon">
                        <img src="/images/icon/arrow_home_icon.svg" alt="" aria-hidden="true">
                    </i>
                </a>
            </div>
            <div class="home_news_tabs section_scroll" role="tablist" aria-label="법인소식 분류">
                <button type="button" role="tab" class="active">공지사항</button>
                <button type="button" role="tab">세미나</button>
                <button type="button" role="tab">위촉</button>
            </div>
            @{
                
                var news1 = new[]{
                    "LKB평산 국제센터 윤웅걸, 이예지, 이진서, 강두리 변호사 제24차 2026 세계한상대회 참여",
                    "[방송출연] 김희준 대표이사 kbc 광주방송 휴먼토크 <호남호남인> 출연",
                    "[공지] LKB평산, 창동민자역사 임대분양 피해자 대상 8월 18일 집단소송 설명회 개최",
                    "「보이스 피싱 범죄의 유형 분석과 피해구제 실무」─ 이형구, 박병규 변호사 공저 출간"
                };
                var news2 = new[]{
                    "[로집사] 건설산업의 경기대응 세미나_이데일리_Q&A"
                };
                var news3 = new[]{
                    "[송시현변호사] 2026대한변호사협회 ESG특별위원회위원 위촉",
                    "[김훈영변호사] 대한치과의사협회 법률고문단 위원 위촉",
                    "[강두리변호사] 2026서울지방노동위원회 공익위원 위촉",
                    "[강두리 변호사] 2026금융위원회 법률자문위원 위촉"
                };

                var newsGroups = new[] {
                    new { Category = "공지사항", Items = news1 },
                    new { Category = "세미나", Items = news2 },
                    new { Category = "위촉", Items = news3 }
                };
            }
            @for (var j = 0; j < newsGroups.Length; j++)
            {
                var group = newsGroups[j];

                <ul class="home_news_list section_scroll" hidden="@(j != 0)">
                    @foreach (var title in group.Items)
                    {
                        <li data-news-type="@group.Category">
                            <a href="/news/detail">
                                <p class="post_title">@title</p>
                                <div class="post_meta">
                                    <span class="post_category">@group.Category</span>
                                    <time class="post_date">26-00-00</time>
                                </div>
                            </a>
                        </li>
                    }
                </ul>
            }
            <a class="button m_button" href="/news">
                소식 더보기
                <i class="svg_icon arrow_hover_icon arrow_home_icon">
                    <img src="/images/icon/arrow_home_icon.svg" alt="" aria-hidden="true">
                </i>
            </a>
        </div>
    </section>
    <section class="home_about section">
        <video class="home_about_video" autoplay muted loop playsinline preload="metadata" poster="/images/home/home_about_bg.png" aria-hidden="true">
            <source src="/images/home/home_about_bg.mp4" type="video/mp4">
        </video>
        <div class="about_inner">
            <div class="about_copy">
