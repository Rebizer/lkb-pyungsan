                    문의하기
                    <i class="svg_icon arrow_hover_icon arrow_right_icon">
                        <img src="/images/icon/arrow_right_icon.svg" alt="" aria-hidden="true">
                    </i>
                </span>
            </a>
            <a href="/contact" class="section_scroll">
                <h3>오시는길</h3>
                <p>LKB평산의 위치와 방문 방법을 안내합니다.</p>
                <span class="image_label">
                    자세히 보기
                    <i class="svg_icon arrow_hover_icon arrow_right_icon">
                        <img src="/images/icon/arrow_right_icon.svg" alt="" aria-hidden="true">
                    </i>
                </span>
            </a>
        </div>
    </section>
    <section class="office_banner">
        <div class="container-lg">
            @for (var i = 0; i < officeLocations.Length; i++)
            {
                var office = officeLocations[i];

                <a href="@office.Url">
                    <h3 class="image_label">
                        @office.Name
                        <i class="svg_icon office_banner_link_icon">
                            <img src="/images/icon/office_banner_link_icon.svg" alt="" aria-hidden="true">
                        </i>
                    </h3>
                    <p>@office.Address</p>
                    <p>@office.Phone</p>
                </a>
            }
        </div>
    </section>
</main>

