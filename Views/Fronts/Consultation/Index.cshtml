@{
    ViewData["Title"] = "상담신청";
    ViewData["Description"] = "LKB평산의 전문변호사에게 법률 상담을 문의하세요. 웅진관 02-582-8500, 정곡관 02-596-7007.";
    ViewData["SchemaType"] = "WebPage";
    ViewData["BodyClass"] = "";
    var realUrl = Context.Request.Scheme + "://" + Context.Request.Host;
    var currentUrl = realUrl + Context.Request.Path;
}

@section meta {
    <title>상담신청 | 법무법인 LKB평산</title>
    <meta name="Title" content="상담신청 | 법무법인 LKB평산">
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="LKB평산의 전문변호사에게 법률 상담을 문의하세요. 웅진관 02-582-8500, 정곡관 02-596-7007.">
    <meta name="application-name" content="법무법인 LKB평산">
    <meta name="robots" content="noindex,nofollow" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="법무법인 LKB평산">
    @await Html.PartialAsync("~/Views/Shared/Common/_Schema.cshtml")
}
@section ogtags {
    <meta property="og:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta property="og:locale" content="ko_KR">
    <meta property="og:type" content="website">
    <meta property="og:title" content="상담신청">
    <meta property="og:site_name" content="법무법인 LKB평산">
    <meta property="og:description" content="LKB평산의 전문변호사에게 법률 상담을 문의하세요. 웅진관 02-582-8500, 정곡관 02-596-7007.">
    <meta property="og:url" content="@currentUrl">

    <meta name="twitter:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="상담신청">
    <meta name="twitter:site" content="법무법인 LKB평산">
    <meta name="twitter:description" content="LKB평산의 전문변호사에게 법률 상담을 문의하세요. 웅진관 02-582-8500, 정곡관 02-596-7007.">
    <meta name="twitter:url" content="@currentUrl">
}

@section headtag {
    @Html.Raw(ViewBag.companymodel.HeadTag)
}

@section headtagnext {
    @Html.Raw(ViewBag.companymodel.HeadNextTag)
}

@section scripttag {
    @Html.Raw(ViewBag.companymodel.ScriptTag)
}

@section css {
    <link rel="stylesheet" href="~/css/pages/consultation/index.css" asp-append-version="true">
}

@section scripts {
    <script src="~/js/pages/consultation/index.js" asp-append-version="true"></script>
}


<main id="main" class="sub_page section">
    <div class="container-md">
        <div class="page_heading align_left">
            <nav class="breadcrumb" aria-label="현재 위치">
                <ol>
                    <li><a href="/">Home</a></li>
                    <li aria-current="page">상담신청</li>
                </ol>
            </nav>
            <h1 class="section_scroll">상담신청</h1>
        </div>
        <section class="consultation_sec section_scroll">
            <p class="consult_intro section_scroll">누구든지 살다 보면 원치 않게 법률적 분쟁에 휘말릴 수 있습니다.
                이런 경우 주변에 법률을 잘 아는 사람을 찾게 되는데 딱히 떠오르는 사람이 없는 때가 많습니다.
                만약 귀하가 지금 그런 상태에 있다면 아래의 전화번호를 이용해 주시기 바랍니다.
                송무 경험이 풍부한 각 분야의 전문변호사들을 연결하여 친절하고 명쾌하게 귀하의 법률문제에 대한 조언과 조력을 아끼지 않을 것입니다.</p>
            <form class="consult_form section_scroll" novalidate="">
                <div class="form_row">
                    <label for="consult_name">성함<span>*</span></label>
                    <input id="consult_name" name="name" required="" maxlength="50" autocomplete="name" placeholder="성함을 입력해 주세요.">
                </div>
                <div class="form_row">
                    <label for="consult_phone">연락처<span>*</span></label>
                    <input id="consult_phone" name="phone" type="tel" required="" maxlength="20" autocomplete="tel" inputmode="tel" placeholder="연락처를 입력해 주세요.">
                </div>
                <div class="form_row">
                    <label for="consult_message">문의내용</label>
                    <textarea id="consult_message" name="message" maxlength="3000" rows="6" placeholder="문의 내용을 입력해 주세요."></textarea>
                </div>
                <div class="form_bottom">
                    <label class="checkbox_label">
                        <input class="checkbox_input" name="consent" type="checkbox" required>
                        <span><strong>개인정보 수집 및 이용</strong>에 동의합니다.</span>
                    </label>
                    <a class="text_link" href="/policy/privacy" target="_blank" rel="noopener noreferrer">전문보기</a>
                    <button type="submit" class="button primary">상담 신청하기</button>
                </div>
            </form>
            <div class="consult_contact section_scroll">
                <div>
                    <h2>연락처 및 상담시간 안내</h2>
                    <p>평일 09:00 ~ 18:00 (점심시간 12:00~13:00)</p>
                </div>
                <a href="tel:025828500">웅진관<strong>02-582-8500</strong></a>
                <a href="tel:025967007">정곡관<strong>02-596-7007</strong></a>
            </div>
        </section>
    </div>
</main>
