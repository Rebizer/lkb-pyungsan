}

<main id="main" class="sub_page list_page section" data-page-size="40">
    <div class="page_heading container-md">
        <nav class="breadcrumb" aria-label="현재 위치">
            <ol>
                <li><a href="/">Home</a></li>
                <li>업무분야</li>
                <li aria-current="page">센터별</li>
            </ol>
        </nav>
        <h1 class="section_scroll">업무분야</h1>
        <p class="section_scroll">다양한 법률 문제에 대응하는 LKB평산의 전문 분야를 확인하세요.</p>
    </div>
    <form class="list_search" role="search">
        <label class="search_box">
            <span class="sr_only">검색어를 입력해 주세요.</span>
            <input type="search" name="q" placeholder="검색어를 입력해 주세요.">
            <button type="submit" aria-label="검색">
                <i class="svg_icon search_icon">
                    <img src="/images/icon/search_icon.svg" alt="">
                </i>
            </button>
        </label>
    </form>
    <section class="container-md listing_section">
        <nav class="category_tabs" aria-label="분류"><a href="/practice">분야별</a><a href="/centers" class="active" aria-current="page">센터별</a><a href="/regions">지역별</a></nav>
        <p class="result_count" role="status">Total. <strong>30건</strong></p>
        <ul class="practice_grid">
            @for (var i = 0; i < practiceGridItems1.Length; i++)
            {
                var item = practiceGridItems1[i];

                <li class="searchable_item">
                    <a href="/center">
                        @item.Label
                        <span aria-hidden="true" class="image_label">
                            <i class="svg_icon arrow_hover_icon arrow_right_icon external_link_icon">
                                <img src="/images/icon/external_link_icon.svg" alt="" aria-hidden="true">
                            </i>
                        </span>
                    </a>
                </li>
            }
        </ul>
        <p class="no_results" role="status" hidden="">검색 결과가 없습니다. 다른 검색어로 다시 검색해 주세요.</p>
        <partial name="Common/_Pagination" />
    </section>
</main>
