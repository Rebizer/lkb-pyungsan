@{
    ViewData["Title"] = "업무분야 - 지역별";
    ViewData["Description"] = "다양한 법률 문제에 대응하는 LKB평산의 지역별 전문 분야를 확인하세요.";
    ViewData["SchemaType"] = "CollectionPage";
    ViewData["BodyClass"] = "";
    var realUrl = Context.Request.Scheme + "://" + Context.Request.Host;
    var currentUrl = realUrl + Context.Request.Path;

    // practice_grid 반복 콘텐츠
    var practiceGridItems1 = new[]
    {
        new
        {
            Label = "영미권"
        },
        new
        {
            Label = "유럽권"
        },
        new
        {
            Label = "중국팀"
        },
        new
        {
            Label = "일본팀"
        },
        new
        {
            Label = "베트남팀"
        }
    };
}

@section meta {
    <title>업무분야 - 지역별 | 법무법인 LKB평산</title>
    <meta name="Title" content="업무분야 - 지역별 | 법무법인 LKB평산">
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="다양한 법률 문제에 대응하는 LKB평산의 지역별 전문 분야를 확인하세요.">
    <meta name="application-name" content="법무법인 LKB평산">
    <meta name="robots" content="index,follow">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="법무법인 LKB평산">
    @await Html.PartialAsync("~/Views/Shared/Common/_Schema.cshtml")
}
@section ogtags {
    <meta property="og:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta property="og:locale" content="ko_KR">
    <meta property="og:type" content="website">
    <meta property="og:title" content="업무분야 - 지역별">
    <meta property="og:site_name" content="법무법인 LKB평산">
    <meta property="og:description" content="다양한 법률 문제에 대응하는 LKB평산의 지역별 전문 분야를 확인하세요.">
    <meta property="og:url" content="@currentUrl">

    <meta name="twitter:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="업무분야 - 지역별">
    <meta name="twitter:site" content="법무법인 LKB평산">
    <meta name="twitter:description" content="다양한 법률 문제에 대응하는 LKB평산의 지역별 전문 분야를 확인하세요.">
    <meta name="twitter:url" content="@currentUrl">
}

@section headtag {
    @Html.Raw(ViewBag.companymodel.HeadTag)
}

@section headtagnext {
    @Html.Raw(ViewBag.companymodel.HeadNextTag)
}

@section scripttag {
    @Html.Raw(ViewBag.companymodel.ScriptTag)
}

@section css {
    <link rel="stylesheet" href="~/css/pages/practice/index.css" asp-append-version="true">
}

<main id="main" class="sub_page list_page section" data-page-size="40">
    <div class="page_heading container-md">
        <nav class="breadcrumb" aria-label="현재 위치">
            <ol>
                <li><a href="/">Home</a></li>
                <li>업무분야</li>
                <li aria-current="page">지역별</li>
            </ol>
        </nav>
        <h1 class="section_scroll">업무분야</h1>
        <p class="section_scroll">다양한 법률 문제에 대응하는 LKB평산의 전문 분야를 확인하세요.</p>
    </div>
    <form class="list_search" role="search">
        <label class="search_box">
            <span class="sr_only">검색어를 입력해 주세요.</span>
            <input type="search" name="q" placeholder="검색어를 입력해 주세요.">
            <button type="submit" aria-label="검색">
                <i class="svg_icon search_icon">
                    <img src="/images/icon/search_icon.svg" alt="">
                </i>
            </button>
        </label>
    </form>
    <section class="container-md listing_section">
        <nav class="category_tabs" aria-label="분류"><a href="/practice">분야별</a><a href="/centers">센터별</a><a href="/regions" class="active" aria-current="page">지역별</a></nav>
        <p class="result_count" role="status">Total. <strong>5건</strong></p>
        <ul class="practice_grid">
            @for (var i = 0; i < practiceGridItems1.Length; i++)
            {
                var item = practiceGridItems1[i];

                <li class="searchable_item">
                    <a href="/regions/detail">
                        @item.Label
                        <span aria-hidden="true" class="image_label">
                            <i class="svg_icon arrow_hover_icon arrow_right_icon">
                                <img src="/images/icon/arrow_right_icon.svg" alt="" aria-hidden="true">
                            </i>
                        </span>
                    </a>
                </li>
            }
        </ul>
        <p class="no_results" role="status" hidden="">검색 결과가 없습니다. 다른 검색어로 다시 검색해 주세요.</p>
        <partial name="Common/_Pagination" />
    </section>
</main>
