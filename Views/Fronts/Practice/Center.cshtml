    // 센터 구성원 슬라이드와 썸네일
    var centerMembers = new[]
    {
        new
        {
            Image = "/images/members/member_14.png",
            Text = "홍길동"
        },
        new
        {
            Image = "/images/members/member_16.png",
            Text = "김도윤"
        },
        new
        {
            Image = "/images/members/member_17.png",
            Text = "이서현"
        },
        new
        {
            Image = "/images/members/member_18.png",
            Text = "박준호"
        },
        new
        {
            Image = "/images/members/member_15.png",
            Text = "정민서"
        },
        new
        {
            Image = "/images/members/member_13.png",
            Text = "최현우"
        }
    };

    // 업무사례 슬라이드 시안
    var centerCases = new[]
    {
        new
        {
            Text = "불기소",
            Title = "제조공장 끼임 사고 관련 경영책임자 불기소 사례",
            Description = "제조공장 사고와 관련하여 안전보건 관리체계와 개선 조치 이행 자료를 분석하고, 경영책임자의 의무 이행을 소명해 불기소 처분을 이끌어냈습니다.",
            Members = new[]
            {
                new { Name = "김희준", Image = "/images/members/member_19.png", Url = "/members/detail" }
            }
        },
        new
        {
            Text = "무죄",
            Title = "건설현장 추락 사고 관련 중대재해처벌법 위반 무죄 사례",
            Description = "건설현장 추락 사고에서 도급 관계와 안전관리 업무 분담을 검토하고, 의무 위반 및 사고와의 인과관계를 다투어 무죄 판결을 받았습니다.",
            Members = new[]
            {
                new { Name = "김강대", Image = "/images/members/member_20.png", Url = "/members/detail" },
                new { Name = "나민경", Image = "/images/members/member_21.png", Url = "/members/detail" }
            }
        },
        new
        {
            Text = "집행유예",
            Title = "물류시설 사망 사고 관련 현장책임자 집행유예 사례",
            Description = "물류시설 사고에 대한 현장책임자의 형사재판에서 사고 후 재발 방지 조치와 피해 회복 노력 등을 소명하여 집행유예 판결을 받았습니다.",
            Members = new[]
            {
                new { Name = "나민경", Image = "/images/members/member_21.png", Url = "/members/detail" }
