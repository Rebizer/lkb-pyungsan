    <meta property="og:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta property="og:locale" content="ko_KR">
    <meta property="og:type" content="website">
    <meta property="og:title" content="중대재해센터">
    <meta property="og:site_name" content="법무법인 LKB평산">
    <meta property="og:description" content="중대재해 예방 체계 점검부터 수사·재판 대응까지 LKB평산 중대재해센터의 법률서비스를 소개합니다.">
    <meta property="og:url" content="@currentUrl">
    
    <meta name="twitter:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="중대재해센터">
    <meta name="twitter:site" content="법무법인 LKB평산">
    <meta name="twitter:description" content="중대재해 예방 체계 점검부터 수사·재판 대응까지 LKB평산 중대재해센터의 법률서비스를 소개합니다.">
    <meta name="twitter:url" content="@currentUrl">
}

@section headtag {
    @Html.Raw(ViewBag.companymodel.HeadTag)
}

@section headtagnext {
    @Html.Raw(ViewBag.companymodel.HeadNextTag)
}

@section scripttag {
    @Html.Raw(ViewBag.companymodel.ScriptTag)
}

@section css {
    <link rel="stylesheet" href="~/css/pages/cases/index.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/home/common.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/practice/center_header.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/practice/center.css" asp-append-version="true">
}

@section scripts {
    <script src="~/js/pages/practice/center.js" asp-append-version="true"></script>
}


<main id="main" class="center_page">
    <section class="center_hero section">
        <img src="/images/practice/industrial_safety_hero.png" alt="산업현장 안전을 점검하는 전문가" fetchpriority="high">
        <div class="center_hero_content">
            <h1 class="section_scroll">중대재해 예방과 대응
                현장의 안전을 위한 법률 파트너</h1>
            <p class="section_scroll">예방 체계 점검부터 수사·재판 대응까지 전문적인 법률서비스를 제공합니다.</p>
        </div>
        <a class="scroll_hint" href="#center_intro">scroll down<span></span></a>
    </section>
    <section id="center_intro" class="center_intro section">
        <div class="container-lg center_content">
            <div class="section_scroll">
                <p class="primary_text">중대재해센터 소개</p>
                <h2>현장을 이해하고,
                    대응 방향을 제시합니다.</h2>
                <p>중대재해는 현장의 안전관리와 기업의 법적 책임을 함께 살펴야 하는 사안입니다.
                    LKB평산 중대재해센터는 안전보건 관리체계 점검부터
                    사고 발생 후 초기 대응, 수사와 재판까지 단계별 법률 지원을 제공합니다.</p>
                <p>사실관계와 현장 자료를 면밀히 검토하고, 기업의 업종과 사업장 특성에 맞는 대응 전략을 수립합니다.
                    예방과 대응 전 과정에서 주요 쟁점을 명확히 안내하고 실질적인 개선 방향을 함께 모색합니다.</p>
            </div>
            <img class="section_scroll" src="/images/practice/industrial_safety_meeting.png" alt="현장 안전과 법률 대응을 검토하는 회의" loading="lazy">
        </div>
    </section>
    <section id="center_professionals" class="center_professionals section">
        <div class="container-lg center_content">
            <h2 class="english_heading section_scroll">PROFESSIONALS</h2>
            <div class="section_heading section_scroll">
                <div>
                    <h3>센터 구성원</h3>
                    <p>현장과 법률에 대한 깊은 이해를 바탕으로
                        중대재해 예방과 대응을 함께하는 전문가들입니다.</p>
                </div>
                <a class="button pc_button" href="/members">
                    구성원 더보기
                    <i class="svg_icon arrow_hover_icon arrow_more_icon">
                        <img src="/images/icon/arrow_more_icon.svg" alt="" aria-hidden="true">
                    </i>
                </a>
            </div>
        </div>
        <div class="center_profile section_scroll">
            <div class="center_member_slider swiper" aria-label="센터 구성원">
                <div class="swiper-wrapper">
                    @for (var i = 0; i < centerMembers.Length; i++)
                    {
                        var member = centerMembers[i];

                        <div class="swiper-slide">
                            <div class="container-lg center_content center_profile_inner">
                                <div class="center_profile_text">
                                    <p class="center_member_role">구성원변호사</p>
                                    <h3>
                                        <a href="/members/detail">@member.Text</a>
                                    </h3>
                                    <ul>
                                        @for (var j = 0; j < memberCareers.Length; j++)
                                        {
                                            <li>@memberCareers[j].Text</li>
                                        }
                                    </ul>
                                </div>
                                <a class="center_portrait_frame" href="/members/detail" aria-label="@(member.Text) 구성원 상세보기">
                                    <img src="@member.Image" alt="@member.Text" width="600" height="600" loading="lazy">
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="container-lg center_content center_member_navigation">
                <div class="center_member_controls">
                    <button type="button" class="center_member_prev center_arrow" aria-label="이전 구성원">
                        <i class="svg_icon arrow_hover_icon arrow_more_icon icon_left">
                            <img src="/images/icon/arrow_more_icon.svg" alt="">
                        </i>
                    </button>
                    <div class="center_member_thumbs swiper" aria-label="구성원 선택">
                        <div class="swiper-wrapper">
                            @for (var i = 0; i < centerMembers.Length; i++)
                            {
                                var member = centerMembers[i];

                                <div class="swiper-slide">
                                    <button type="button" data-member-index="@i" aria-label="@(member.Text) 프로필 보기" aria-pressed="@(i == 0 ? "true" : "false")">
                                        <img src="@member.Image" alt="" width="100" height="100" loading="lazy">
                                        <span>@member.Text</span>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                    <button type="button" class="center_member_next center_arrow" aria-label="다음 구성원">
                        <i class="svg_icon arrow_hover_icon arrow_more_icon">
                            <img src="/images/icon/arrow_more_icon.svg" alt="">
                        </i>
                    </button>
                </div>

                <a class="button m_button" href="/members">
                    구성원 더보기
                    <i class="svg_icon arrow_hover_icon arrow_more_icon">
                        <img src="/images/icon/arrow_more_icon.svg" alt="" aria-hidden="true">
                    </i>
                </a>
            </div>
        </div>
        
    </section>
    <section id="center_cases" class="center_cases section">
        <div class="container-lg center_content">
            <h2 class="english_heading section_scroll">CASES</h2>
            <div class="section_heading section_scroll">
                <p>중대재해 사건의 주요 쟁점과 대응 사례를 확인하세요.</p>
                <a class="button pc_button" href="/cases">
                    업무사례 더보기
                    <i class="svg_icon arrow_hover_icon arrow_more_icon">
                        <img src="/images/icon/arrow_more_icon.svg" alt="" aria-hidden="true">
                    </i>
                </a>
            </div>
            <div class="center_case_slider swiper section_scroll" aria-label="센터 업무사례">
                <ul class="swiper-wrapper">
                    @for (var i = 0; i < centerCases.Length * 4; i++)
                    {
                        var item = centerCases[i % centerCases.Length];

                        <li class="case_card swiper-slide">
                            <a class="case_summary_link" href="/cases/detail">
                                <p class="post_category">노사/중대재해</p>
                                <strong>@item.Text</strong>
                                <p class="post_title">@item.Title</p>
                                <p class="post_excerpt ellipsis line2">@item.Description</p>
                                <time class="post_date">26-00-00</time>
                            </a>
                            <ul class="case_people" aria-label="관련 구성원">
                                @for (var j = 0; j < item.Members.Length; j++)
                                {
                                    var member = item.Members[j];

                                    <li>
                                        <a class="case_member" href="@member.Url" aria-label="@(member.Name) 구성원 상세보기">
                                            <span class="case_member_photo">
                                                <img src="@member.Image" alt="" width="60" height="60" loading="lazy">
                                                <i class="svg_icon member_more_icon" aria-hidden="true">
                                                    <img src="/images/icon/member_more_icon.svg" alt="">
                                                </i>
                                            </span>
                                            <span class="case_member_name">@member.Name</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
            </div>
            <div class="center_case_controls">
                <div class="center_case_scrollbar swiper-scrollbar"></div>
                <button type="button" class="center_case_prev center_arrow" aria-label="이전 업무사례">
                    <i class="svg_icon arrow_hover_icon arrow_more_icon icon_left">
                        <img src="/images/icon/arrow_more_icon.svg" alt="">
                    </i>
                </button>
                <button type="button" class="center_case_next center_arrow" aria-label="다음 업무사례">
                    <i class="svg_icon arrow_hover_icon arrow_more_icon">
                        <img src="/images/icon/arrow_more_icon.svg" alt="">
                    </i>
                </button>
            </div>

            <a class="button m_button" href="/cases">
                업무사례 더보기
                <i class="svg_icon arrow_hover_icon arrow_more_icon">
                    <img src="/images/icon/arrow_more_icon.svg" alt="" aria-hidden="true">
                </i>
            </a>
        </div>
    </section>
    <section class="contact_sec container-lg section">
        <h2 class="english_heading section_scroll">CONTACT</h2>
        <p class="section_scroll">신뢰할 수 있는 법률 파트너, LKB평산이 함께하겠습니다.</p>
        <div class="contact_cards">
            <a href="/consultation" class="section_scroll">
                <h3>온라인 문의</h3>
                <p>법률 상담이 필요하시면 문의를 남겨주세요.</p>
                <span class="image_label">
                    문의하기
                    <i class="svg_icon arrow_hover_icon arrow_right_icon">
                        <img src="/images/icon/arrow_right_icon.svg" alt="" aria-hidden="true">
                    </i>
                </span>
            </a>
            <a href="https://pf.kakao.com/_xgkxfHn/chat" target="_blank" rel="noopener noreferrer" class="section_scroll">
                <h3>카카오톡 문의</h3>
                <p>궁금한 법률 문제를 카카오톡으로 문의하세요.</p>
                <span class="image_label">
                    문의하기
                    <i class="svg_icon arrow_hover_icon arrow_right_icon">
                        <img src="/images/icon/arrow_right_icon.svg" alt="" aria-hidden="true">
                    </i>
                </span>
            </a>
            <a href="/contact" class="section_scroll">
                <h3>오시는길</h3>
                <p>LKB평산의 위치와 방문 방법을 안내합니다.</p>
                <span class="image_label">
                    자세히 보기
                    <i class="svg_icon arrow_hover_icon arrow_right_icon">
                        <img src="/images/icon/arrow_right_icon.svg" alt="" aria-hidden="true">
                    </i>
                </span>
            </a>
        </div>
    </section>
    <section class="office_banner">
        <div class="container-lg">
            @for (var i = 0; i < officeLocations.Length; i++)
            {
                var office = officeLocations[i];

                <a href="@office.Url">
                    <h3 class="image_label">
                        @office.Name
                        <i class="svg_icon office_banner_link_icon">
                            <img src="/images/icon/office_banner_link_icon.svg" alt="" aria-hidden="true">
                        </i>
                    </h3>
                    <p>@office.Address</p>
                    <p>@office.Phone</p>
                </a>
            }
        </div>
    </section>
</main>