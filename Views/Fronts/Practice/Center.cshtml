    ViewData["Title"] = "중대재해센터";
    ViewData["Description"] = "중대재해 예방 체계 점검부터 수사·재판 대응까지 LKB평산 중대재해센터의 법률서비스를 소개합니다.";
    ViewData["SchemaType"] = "WebPage";
    ViewData["BodyClass"] = "center_landing";
    ViewData["CenterHeader"] = true;
    var realUrl = Context.Request.Scheme + "://" + Context.Request.Host;
    var currentUrl = realUrl + Context.Request.Path;

    // 구성원 약력 시안
