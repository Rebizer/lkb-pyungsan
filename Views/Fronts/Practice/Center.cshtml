@section meta {
    <title>중대재해센터 | 법무법인 LKB평산</title>
    <meta name="Title" content="중대재해센터 | 법무법인 LKB평산">
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="중대재해 예방 체계 점검부터 수사·재판 대응까지 LKB평산 중대재해센터의 법률서비스를 소개합니다.">
    <meta name="application-name" content="법무법인 LKB평산">
    <meta name="robots" content="index,follow">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="법무법인 LKB평산">
    @await Html.PartialAsync("~/Views/Shared/Common/_Schema.cshtml")
}
