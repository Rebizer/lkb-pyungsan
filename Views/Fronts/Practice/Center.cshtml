    // 하단 사무소 안내
    var officeLocations = new[]
    {
        new
        {
            Name = "웅진관",
            Url = "/contact",
            Address = "서울 서초구 반포대로30길 81 웅진타워 4층, 13층, 14층, 16층",
            Phone = "02-582-8500"
        },
        new
        {
            Name = "정곡관",
            Url = "/contact?office=jeonggok",
            Address = "서울 서초구 법원로 15 정곡빌딩 서관 지하 1층, 1~5층",
