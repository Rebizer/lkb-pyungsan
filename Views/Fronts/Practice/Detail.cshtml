@{
    ViewData["Title"] = "형사 업무분야";
    ViewData["Description"] = "수사부터 재판까지, 형사사건의 체계적인 대응";
    ViewData["SchemaType"] = "WebPage";
    ViewData["BodyClass"] = "";
    var realUrl = Context.Request.Scheme + "://" + Context.Request.Host;
    var currentUrl = realUrl + Context.Request.Path;
}

@section meta {
    <title>형사 업무분야 | 법무법인 LKB평산</title>
    <meta name="Title" content="형사 업무분야 | 법무법인 LKB평산">
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="수사부터 재판까지, 형사사건의 체계적인 대응">
    <meta name="application-name" content="법무법인 LKB평산">
    <meta name="robots" content="noindex,nofollow" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="법무법인 LKB평산">
    @await Html.PartialAsync("~/Views/Shared/Common/_Schema.cshtml")
}
@section ogtags {
    <meta property="og:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta property="og:locale" content="ko_KR">
    <meta property="og:type" content="website">
    <meta property="og:title" content="형사 업무분야">
    <meta property="og:site_name" content="법무법인 LKB평산">
    <meta property="og:description" content="수사부터 재판까지, 형사사건의 체계적인 대응">
    <meta property="og:url" content="@currentUrl">
    <meta name="twitter:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="형사 업무분야">
    <meta name="twitter:site" content="법무법인 LKB평산">
    <meta name="twitter:description" content="수사부터 재판까지, 형사사건의 체계적인 대응">
    <meta name="twitter:url" content="@currentUrl">
}

@section headtag {
    @Html.Raw(ViewBag.companymodel.HeadTag)
}

@section headtagnext {
    @Html.Raw(ViewBag.companymodel.HeadNextTag)
}

@section scripttag {
    @Html.Raw(ViewBag.companymodel.ScriptTag)
}

@section css {
    <link rel="stylesheet" href="/css/editor.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/practice/detail.css" asp-append-version="true">
}

<main id="main" class="sub_page section">
    <div class="page_heading container-md align_left">
        <nav class="breadcrumb" aria-label="현재 위치">
            <ol>
                <li><a href="/">Home</a></li>
                <li>업무분야</li>
                <li aria-current="page">형사</li>
            </ol>
        </nav>
        <h1 class="section_scroll">형사</h1>
        <p class="section_scroll">수사부터 재판까지, 형사사건의 체계적인 대응</p>
    </div>
    <div class="detail_banner section_scroll">
        <img src="/images/practice/criminal_law_banner.png" alt="고층 빌딩과 하늘">
    </div>
    <section class="container-md practice_detail section_scroll">
        <h2 class="sr_only">형사 법률서비스</h2>
        <div class="ck-content">
            <p>형사사건은 수사 초기의 대응부터 재판에 이르기까지 각 단계에 맞는 전략과 면밀한 사실관계 검토가 중요합니다.
                LKB평산은 법원·검찰 등에서 쌓은 실무경험을 바탕으로 사건의 쟁점을 분석하고, 의뢰인의 상황에 맞는 대응 방향을 제시합니다.
                고소·고발, 경찰·검찰 조사, 압수수색 및 구속영장 대응부터 공판과 항소심까지 형사절차 전반에 걸쳐 법률서비스를 제공합니다.
                개인의 형사사건뿐 아니라 기업 경영 과정에서 발생하는 횡령·배임, 사기 등 다양한 사건에서 증거와 법리를 검토하고 변론 전략을 수립합니다.
                의뢰인의 권익 보호를 위해 무죄를 다투는 사건에서는 혐의와 증거를 면밀히 살피고, 양형이 쟁점인 사건에서는 참작 사유와 관련 자료를 체계적으로 정리합니다.
                피해자를 대리하는 경우에도 고소와 피해 회복을 위한 법적 대응을 지원하며, 절차의 진행 상황과 주요 쟁점을 의뢰인에게 명확하게 안내합니다.</p>
        </div>
        <div class="related_cards">
            <a href="/members">
                <h3 class="image_label">
                    관련 구성원 보기
                    <span class="image_label">
                        <i class="svg_icon arrow_hover_icon arrow_right_icon">
                            <img src="/images/icon/arrow_right_icon.svg" alt="" aria-hidden="true">
                        </i>
                    </span>
                </h3>
                <p>해당 분야의 경험과 전문성을 갖춘 변호사를 만나보세요.</p>
            </a>
            <a href="/cases">
                <h3 class="image_label">
                    관련 업무사례 보기
                    <span class="image_label">
                        <i class="svg_icon arrow_hover_icon arrow_right_icon">
                            <img src="/images/icon/arrow_right_icon.svg" alt="" aria-hidden="true">
                        </i>
                    </span>
                </h3>
                <p>해당 분야의 주요 사례와 해결 과정을 확인하세요.</p>
            </a>
        </div>
        <div class="back_list"><a class="button" href="/practice">목록으로</a></div>
    </section>
</main>