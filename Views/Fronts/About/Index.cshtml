@{
    ViewData["Title"] = "LKB평산 소개";
    ViewData["Description"] = "법무법인 LKB평산의 철학과 전문성, 법률서비스 역량을 소개합니다.";
    ViewData["SchemaType"] = "WebPage";
    ViewData["BodyClass"] = "";
    var realUrl = Context.Request.Scheme + "://" + Context.Request.Host;
    var currentUrl = realUrl + Context.Request.Path;
}

@section meta {
    <title>LKB평산 소개 | 법무법인 LKB평산</title>
    <meta name="Title" content="LKB평산 소개 | 법무법인 LKB평산">
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="법무법인 LKB평산의 철학과 전문성, 법률서비스 역량을 소개합니다.">
    <meta name="application-name" content="법무법인 LKB평산">
    <meta name="robots" content="index,follow">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="법무법인 LKB평산">
    @await Html.PartialAsync("~/Views/Shared/Common/_Schema.cshtml")
}
@section ogtags {
    <meta property="og:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta property="og:locale" content="ko_KR">
    <meta property="og:type" content="website">
    <meta property="og:title" content="LKB평산 소개">
    <meta property="og:site_name" content="법무법인 LKB평산">
    <meta property="og:description" content="법무법인 LKB평산의 철학과 전문성, 법률서비스 역량을 소개합니다.">
    <meta property="og:url" content="@currentUrl">
    <meta name="twitter:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="LKB평산 소개">
    <meta name="twitter:site" content="법무법인 LKB평산">
    <meta name="twitter:description" content="법무법인 LKB평산의 철학과 전문성, 법률서비스 역량을 소개합니다.">
    <meta name="twitter:url" content="@currentUrl">
}

@section headtag {
    @Html.Raw(ViewBag.companymodel.HeadTag)
}

@section headtagnext {
    @Html.Raw(ViewBag.companymodel.HeadNextTag)
}

@section scripttag {
    @Html.Raw(ViewBag.companymodel.ScriptTag)
}

@section css {
    <link rel="stylesheet" href="~/css/pages/about/index.css" asp-append-version="true">
}

@section scripts {
    <script src="~/js/pages/about/index.js" asp-append-version="true"></script>
}

<main id="main" class="sub_page">
    <div class="page_heading container-md">
        <nav class="breadcrumb" aria-label="현재 위치">
            <ol>
                <li><a href="/">Home</a></li>
                <li>법인소개</li>
                <li aria-current="page">LKB평산</li>
            </ol>
        </nav>
        <h1>LKB평산 소개</h1>
        <p>LKB평산은 의뢰인의 곁에서 함께하겠습니다.</p>
    </div>
    <div class="about_visual">
        <section class="about_intro container-md">
            <img src="/images/about/office_building.png" alt="LKB평산 소개 빌딩 전경">
            <a href="#about_statement" class="about_scroll">
                <i class="svg_icon scroll_down_icon">
                    <img src="/images/icon/scroll_down_icon.svg" alt="" aria-hidden="true">
                </i>
                scroll down
            </a>
        </section>
        <section id="about_statement" class="about_statement">
            <img src="/images/about/office_building.png" alt="" loading="lazy">
            <div>
                <h2>법무법인 LKB평산은
                    실무 경험을 기반으로 결과를 만들어내는
                    Leading Law Firm입니다.</h2>
                <p>법무법인 LKB평산은 법원·검찰 출신 대표변호사와
                    국회, 공공기관, 대기업, 회계법인, 언론사 등 다양한 분야의 전문가들이 모인 로펌입니다.
                    각 분야에서 검증된 역량을 바탕으로 차별화된 법률 서비스를 제공합니다.</p>
            </div>
        </section>
    </div>
    <section class="about_story container-md">
        <div class="section">
            <div class="story_columns">
                <h2 class="section_scroll">저희 법무법인은
                    이제 신설되어
                    세상으로 나아갑니다.</h2>
                <div>
                <p class="section_scroll">종전 법원 출신 중심의 엘케이비와 검찰 출신 중심의 평산이 합해져 
                    새로운 체제와 이상을 가지고 법조의 신세계를 기약하고 있습니다.

                    저희는 대규모의 전관형 로펌이지만 사건송무만을 벗어나 
                    금융이나 부동산같은 부문별 자문업무를 확대합니다.
                    구성원 개개인의 차별화된 사회적 네트워크와 축적된 경험을 토대로 고객의 리스크 해소에 기여할 것입니다.

                    저희는 강력한 업계경쟁력을 지니고 있지만 시회공헌에도 집중할 것입니다.
                    국익과 연계되는 방산분야와 국격을 드높이는 K -Culture 센터를 출범시킨 것도 그 이유입니다.
                    중대재해팀은 현장의 수많은 전문가들을 모셔와서 사전예방을 염두에 두고 활동하기로 하였습니다.

                    세상의 변화에 대응하여 저희 법인도 집행부의 사고를 늘 혁신하고 신진 인재들을 열성적으로 영입하여 
                    AI시대에 걸맞는 참신한 모습을 유지하고자 합니다.

                    <strong>저희 법무법인의 문을 두드리는 고객분들께 감히 말씀드립니다.</strong> 

                    절대적으로 만족스런 결과를 도출한다고 장담할 수는 없으나 
                    상대적으로 가장 나은 결과를 드릴 수 있다고 자부합니다.
                    법적 쟁송으로 고통을 받는 고객들에게 가족보다도 더 가까운 심정으로 옆에 서 있겠다고 약속드립니다.

                    저희는 국내 법조계를 선도하고 외국에서도 인정받는 그런 법무법인이 되겠습니다.
                    의뢰인에게 신뢰를 넘어서서 존경을 받는 그런 구성원들이 되겠습니다.
                    들어 오실때보다 나가실 때 행복해지시기를 기원합니다.</p>
                </div>
            </div>
            <figure class="directors_photo section_scroll">
                <picture>
                    <source media="(max-width: 768px)" srcset="/images/about/representative_directors_m.png">
                    <img src="/images/about/representative_directors.png" alt="김희준·김병현 대표이사" loading="lazy">
                </picture>
                <figcaption>대표이사 김희준(22기), 김병현(25기)</figcaption>
            </figure>
        </div>
        <div class="section">
            <div class="story_columns">
                <h2 class="section_scroll">폭넓은 분야, 검증된 결과</h2>
                <div class="section_scroll">
                    <p>2012년 설립된 이후, 탁월한 송무역량을 기반으로 민·형사 사건은 물론
                        기업법무, 공정거래, 조세, 행정, 금융, 재건축·재개발, 노무, 지적재산권, 회생·파산, M&A등 
                        모든 분야에 걸친 종합 법률서비스를 제공하면서,
                        성공적인 결과를 도출하고 있습니다.

                        우리 법인의 최대 강점은 <strong>"모든 대표변호사가 사소한 사건까지 모두 파악하여 꼼꼼하게 대처하고 있다"</strong>는 것입니다.
                        대표변호사들이 의뢰인을 만나고, 서면 작업은 물론 법정의 끊임없는 도전정신을 바탕으로 
                        우수한 법률서비스를 제공하는 우리 법인과 함께 하십시오.

                        탁월한 업무능력을 가진 변호사들이 명쾌한 법률적 해답을 드릴 것이고,
                        의뢰인들과 고락(苦樂)을 함께 할 것입니다.</p>
                </div>
            </div>
        </div>
        <div class="section">
            <div class="value_grid">
                <div class="section_scroll">
                    <h3>송무역량</h3>
                    <p>오랜 실무경험으로 쌓은 탁월한 
                        송무역량을 기반으로 성공적인 결과 도출</p>
                </div>
                <div class="section_scroll">
                    <h3>도덕성&신뢰</h3>
                    <p>대표변호사가 사소한 사건까지 
                        모두 파악하여 꼼꼼하게 대처</p>
                </div>
                <div class="section_scroll">
                    <h3>도전정신</h3>
                    <p>끊임없는 도전정신을 바탕으로 
                        우수한 법률서비스 제공</p>
                </div>
            </div>
        </div>
        <video class="about_empty" autoplay muted loop playsinline preload="metadata" poster="/images/home/home_about_bg.png" aria-hidden="true">
            <source src="/images/about/movielkb.mp4" type="video/mp4">
        </video>
    </section>
</main>
