<main id="main" class="sub_page static_list_page section">
    <div class="page_heading container-md">
        <nav class="breadcrumb" aria-label="현재 위치">
            <ol>
                <li><a href="/">Home</a></li>
                <li aria-current="page">업무사례</li>
            </ol>
        </nav>
        <h1 class="section_scroll">업무사례</h1>
        <p class="section_scroll">복잡한 법률 문제의 해결 과정과 LKB평산의 전문성을 확인하세요.</p>
    </div>
    <div class="list_search" role="search">
        <label class="search_box">
            <span class="sr_only">업무사례를 검색해 주세요.</span>
            <input type="search" name="q" placeholder="업무사례를 검색해 주세요.">
            <button type="button" aria-label="검색">
                <i class="svg_icon search_icon">
                    <img src="/images/icon/search_icon.svg" alt="">
                </i>
            </button>
        </label>
        <button class="button primary" type="button" data-dialog="filter_dialog">
            분야별 찾기
            <i class="svg_icon add_icon">
                <img src="/images/icon/add_icon.svg" alt="" aria-hidden="true">
            </i>
        </button>
    </div>
    <div class="selected_filters" aria-live="polite">
        <span>선택 분야 <b>@(selectedFilters.Length)개</b></span>
        <div class="filter_chips">
            @for (var i = 0; i < selectedFilters.Length; i++)
            {
                <button type="button" aria-label="@(selectedFilters[i]) 선택 해제">
                    @selectedFilters[i]
                    <i class="svg_icon chip_close_icon">
                        <img src="/images/icon/chip_close_icon.svg" alt="" aria-hidden="true">
                    </i>
                </button>
            }
        </div>
        <button type="button" class="filter_reset">
            전체 해제
            <i class="svg_icon reset_icon">
                <img src="/images/icon/reset_icon.svg" alt="" aria-hidden="true">
            </i>
        </button>
    </div>
    <section class="container-md listing_section">
        <p class="result_count" role="status">Total. <strong>9건</strong></p>
        <ul class="case_grid">
            @for (var i = 0; i < caseGridItems1.Length; i++)
            {
                var item = caseGridItems1[i];

                <li class="case_card">
                    <a class="case_summary_link" href="/cases/detail">
                        <span class="post_category">@item.Text</span>
                        <strong>@item.Text2</strong>
                        <p class="post_title">@item.Title</p>
                        <p class="post_excerpt ellipsis line2">@item.Description</p>
                        <time class="post_date">26-00-00</time>
                    </a>
                    <ul class="case_people" aria-label="관련 구성원">
                        @for (var j = 0; j < item.Members.Length; j++)
                        {
                            var member = item.Members[j];

                            <li>
                                <a class="case_member" href="@member.Url" aria-label="@(member.Name) 구성원 상세보기">
                                    <span class="case_member_photo">
                                        <img src="@member.Image" alt="" width="60" height="60" loading="lazy">
                                        <i class="svg_icon member_more_icon" aria-hidden="true">
                                            <img src="/images/icon/member_more_icon.svg" alt="">
                                        </i>
                                    </span>
                                    <span class="case_member_name">@member.Name</span>
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            }
        </ul>
        <partial name="Common/_Pagination" />
    </section>
</main>
