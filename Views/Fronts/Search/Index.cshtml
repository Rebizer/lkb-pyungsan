@section css {
    <link rel="stylesheet" href="~/css/pages/members/index.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/practice/index.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/cases/index.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/news/index.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/search/index.css" asp-append-version="true">
}

@section scripts {
    <script src="~/js/pages/search/index.js" asp-append-version="true"></script>
}

<main id="main" class="sub_page search_page">
    <div class="page_heading container-md">
        <nav class="breadcrumb" aria-label="현재 위치">
            <ol>
                <li><a href="/">Home</a></li>
                <li aria-current="page">통합검색</li>
            </ol>
        </nav>
        <h1>통합검색</h1>
    </div>
    <div class="container-md">
        <div class="global_search">
            <form class="list_search" role="search">
                <label class="search_box">
                    <span class="sr_only">검색어를 입력해 주세요.</span>
                    <input type="search" name="q" placeholder="검색어를 입력해 주세요.">
                    <button type="submit" aria-label="검색">
                        <i class="svg_icon search_icon">
                            <img src="/images/icon/search_icon.svg" alt="">
                        </i>
                    </button>
                </label>
            </form>
        </div>
        <p class="global_result_count"><strong>총 @(totalResultCount)건</strong>의 검색결과가 있습니다.</p>
        <nav class="category_tabs search_sections" aria-label="검색 결과 분류">
            <button type="button" class="active" data-search-section="all" aria-pressed="true">전체 (@totalResultCount)</button>
            <button type="button" data-search-section="search_practice" aria-pressed="false">업무분야 (@practiceGridItems1.Length)</button>
            <button type="button" data-search-section="search_members" aria-pressed="false">구성원 (@memberResultCount)</button>
            <button type="button" data-search-section="search_cases" aria-pressed="false">업무사례 (@caseResultCount)</button>
            <button type="button" data-search-section="search_news" aria-pressed="false">법인소식 (@newsListItems4.Length)</button>
            <button type="button" data-search-section="search_resources" aria-pressed="false">자료실 (@resourceResultCount)</button>
        </nav>
        <section id="search_practice" class="search_group">
            <div class="section_heading">
                <h2>업무분야<span class="search_group_count">(@practiceGridItems1.Length)</span></h2>
                <a class="button" href="/practice">
                    전체보기
                    <i class="svg_icon arrow_hover_icon arrow_more_icon">
                        <img src="/images/icon/arrow_more_icon.svg" alt="" aria-hidden="true">
                    </i>
                </a>
            </div>
            <ul id="search_practice_results" class="practice_grid search_results">
                @for (var i = 0; i < practiceGridItems1.Length; i++)
                {
                    var item = practiceGridItems1[i];

                    <li>
                        <a href="/practice/detail">
                            @item.Label
                            <span class="image_label">
                                <i class="svg_icon arrow_hover_icon arrow_right_icon">
                                    <img src="/images/icon/arrow_right_icon.svg" alt="" aria-hidden="true">
                                </i>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        </section>
        <section id="search_members" class="search_group">
            <div class="section_heading">
                <h2>구성원<span class="search_group_count">(@memberResultCount)</span></h2>
                <a class="button" href="/members">
                    전체보기
                    <i class="svg_icon arrow_hover_icon arrow_more_icon">
                        <img src="/images/icon/arrow_more_icon.svg" alt="" aria-hidden="true">
                    </i>
                </a>
            </div>
            <ul id="search_members_results" class="member_grid search_results">
                @for (var i = 0; i < memberResultCount; i++)
                {
                    var member = members[i % members.Length];

                    <li class="member_card">
                        <a href="/members/detail" aria-label="@(member.Name) 카드 — 대표 구성원 상세 미리보기">
                            <div class="member_info">
                                <p class="member_name">@member.Name</p>
                                <p>@member.Role</p>
                                <dl>
                                    @if (!string.IsNullOrWhiteSpace(member.Email))
                                    {
                                        <div>
                                            <dt>M.</dt>
                                            <dd>@member.Email</dd>
                                        </div>
                                    }
                                    <div>
                                        <dt>T.</dt>
                                        <dd>@member.Phone</dd>
                                    </div>
                                </dl>
                            </div>
                            <div class="member_portrait">
                                <img src="@member.Image" alt="@(member.Name) 변호사" width="600" height="600" loading="lazy">
                            </div>
                        </a>
                    </li>
                }
            </ul>
            <div class="search_more_wrap">
                <button type="button" class="button search_more" aria-controls="search_members_results" aria-label="구성원 한 줄 더보기">
                    <span class="search_more_label">더보기</span>
                    <i class="svg_icon" aria-hidden="true">
                        <img src="/images/icon/add_icon.svg" alt="">
                    </i>
                </button>
                <p class="sr_only search_more_status" role="status" aria-live="polite"></p>
            </div>
        </section>
        <section id="search_cases" class="search_group">
            <div class="section_heading">
                <h2>업무사례<span class="search_group_count">(@caseResultCount)</span></h2>
                <a class="button" href="/cases">
                    전체보기
                    <i class="svg_icon arrow_hover_icon arrow_more_icon">
                        <img src="/images/icon/arrow_more_icon.svg" alt="" aria-hidden="true">
                    </i>
                </a>
            </div>
            <ul id="search_cases_results" class="case_grid search_results">
                @for (var i = 0; i < caseResultCount; i++)
                {
                    var item = caseGridItems3[i % caseGridItems3.Length];

                    <li class="case_card">
                        <a class="case_summary_link" href="/cases/detail">
                            <span class="post_category">@item.Text</span>
                            <strong>@item.Text2</strong>
                            <p class="post_title">@item.Title</p>
                            <p class="post_excerpt ellipsis line2">@item.Description</p>
                            <time class="post_date">26-00-00</time>
                        </a>
                        <ul class="case_people" aria-label="관련 구성원">
                            @for (var j = 0; j < item.Members.Length; j++)
                            {
                                var member = item.Members[j];

                                <li>
                                    <a class="case_member" href="@member.Url" aria-label="@(member.Name) 구성원 상세보기">
                                        <span class="case_member_photo">
                                            <img src="@member.Image" alt="" width="60" height="60" loading="lazy">
                                            <i class="svg_icon member_more_icon" aria-hidden="true">
                                                <img src="/images/icon/member_more_icon.svg" alt="">
                                            </i>
                                        </span>
                                        <span class="case_member_name">@member.Name</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </li>
                }
            </ul>
            <div class="search_more_wrap">
                <button type="button" class="button search_more" aria-controls="search_cases_results" aria-label="업무사례 한 줄 더보기">
                    <span class="search_more_label">더보기</span>
                    <i class="svg_icon" aria-hidden="true">
                        <img src="/images/icon/add_icon.svg" alt="">
                    </i>
                </button>
                <p class="sr_only search_more_status" role="status" aria-live="polite"></p>
            </div>
        </section>
        <section id="search_news" class="search_group" data-page-size="3">
            <div class="section_heading">
                <h2>법인소식<span class="search_group_count">(@newsListItems4.Length)</span></h2>
                <a class="button" href="/news">
                    전체보기
                    <i class="svg_icon arrow_hover_icon arrow_more_icon">
                        <img src="/images/icon/arrow_more_icon.svg" alt="" aria-hidden="true">
                    </i>
                </a>
            </div>
            <ul id="search_news_results" class="news_list search_results">
                @for (var i = 0; i < newsListItems4.Length; i++)
                {
                    var item = newsListItems4[i];

                    <li class="news_row">
                        <a href="/news/detail">
                            <p class="post_title">@item.Title</p>
                            <div class="post_meta">
                                <span class="post_category">@item.Description</span>
                                <time class="post_date">26-00-00</time>
                            </div>
                        </a>
                    </li>
                }
            </ul>
            <div class="search_more_wrap">
                <button type="button" class="button search_more" aria-controls="search_news_results" aria-label="법인소식 3개 더보기">
                    <span class="search_more_label">더보기</span>
                    <i class="svg_icon" aria-hidden="true">
                        <img src="/images/icon/add_icon.svg" alt="">
                    </i>
                </button>
                <p class="sr_only search_more_status" role="status" aria-live="polite"></p>
            </div>
        </section>
        <section id="search_resources" class="search_group">
            <div class="section_heading">
                <h2>자료실<span class="search_group_count">(@resourceResultCount)</span></h2>
                <a class="button" href="/resources">
                    전체보기
                    <i class="svg_icon arrow_hover_icon arrow_more_icon">
                        <img src="/images/icon/arrow_more_icon.svg" alt="" aria-hidden="true">
                    </i>
                </a>
            </div>
            <ul id="search_resources_results" class="resource_grid search_results">
                @for (var i = 0; i < resourceResultCount; i++)
                {
                    var item = resourceGridItems5[i % resourceGridItems5.Length];

                    <li class="resource_card">
                        <a href="/news/detail" class="resource_cover">
                            <figure class="resource_img">
                                <img src="@item.Image" alt="@item.ImageDescription" loading="lazy">
                            </figure>
                            <p class="post_title">@item.Label</p>
                            <div class="post_meta">
                                <span class="post_category">브로슈어</span>
                                <time class="post_date">26-00-00</time>
                            </div>
                        </a>
                        <button class="button download_preview" type="button" data-preview="첨부 PDF 원본이 제공되지 않아 다운로드는 연동 전입니다.">
                            파일 다운로드
                            <i class="svg_icon post_download_icon">
                                <img src="/images/icon/post_download_icon.svg" alt="" aria-hidden="true">
                            </i>
                        </button>
                    </li>
                }
            </ul>
            <div class="search_more_wrap">
                <button type="button" class="button search_more" aria-controls="search_resources_results" aria-label="자료실 한 줄 더보기">
                    <span class="search_more_label">더보기</span>
                    <i class="svg_icon" aria-hidden="true">
                        <img src="/images/icon/add_icon.svg" alt="">
                    </i>
                </button>
                <p class="sr_only search_more_status" role="status" aria-live="polite"></p>
            </div>
        </section>
    </div>
</main>