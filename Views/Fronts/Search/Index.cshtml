@section meta {
    <title>통합검색 | 법무법인 LKB평산</title>
    <meta name="Title" content="통합검색 | 법무법인 LKB평산">
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="LKB평산의 업무분야, 구성원, 업무사례, 소식과 자료를 한 곳에서 검색하세요.">
    <meta name="application-name" content="법무법인 LKB평산">
    <meta name="robots" content="noindex,nofollow" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="법무법인 LKB평산">
    @await Html.PartialAsync("~/Views/Shared/Common/_Schema.cshtml")
}
