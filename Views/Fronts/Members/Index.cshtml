@section css {
    <link rel="stylesheet" href="~/css/pages/members/index.css" asp-append-version="true">
}

<main id="main" class="sub_page static_list_page section">
    <div class="page_heading container-md">
        <nav class="breadcrumb" aria-label="현재 위치">
            <ol>
                <li><a href="/">Home</a></li>
                <li aria-current="page">구성원</li>
            </ol>
        </nav>
        <h1 class="section_scroll">구성원</h1>
        <p class="section_scroll">다양한 분야의 경험과 전문성을 갖춘 LKB평산의 구성원을 소개합니다.</p>
    </div>
    <div class="list_search" role="search">
        <label class="search_box">
            <span class="sr_only">구성원을 검색해 주세요.</span>
            <input type="search" name="q" placeholder="구성원을 검색해 주세요.">
            <button type="button" aria-label="검색">
                <i class="svg_icon search_icon">
                    <img src="/images/icon/search_icon.svg" alt="">
                </i>
            </button>
        </label>
        <button class="button primary" type="button" data-dialog="filter_dialog">
            분야별 찾기
            <i class="svg_icon add_icon">
                <img src="/images/icon/add_icon.svg" alt="" aria-hidden="true">
            </i>
        </button>
    </div>
    <div class="selected_filters" aria-live="polite">
        <span>선택 분야 <b>@(selectedFilters.Length)개</b></span>
        <div class="filter_chips">
            @for (var i = 0; i < selectedFilters.Length; i++)
            {
                <button type="button" aria-label="@(selectedFilters[i]) 선택 해제">
                    @selectedFilters[i]
                    <i class="svg_icon chip_close_icon">
                        <img src="/images/icon/chip_close_icon.svg" alt="" aria-hidden="true">
                    </i>
                </button>
            }
        </div>
        <button type="button" class="filter_reset">
            전체 해제
            <i class="svg_icon reset_icon">
                <img src="/images/icon/reset_icon.svg" alt="" aria-hidden="true">
            </i>
        </button>
    </div>
    <section class="container-md listing_section" aria-label="구성원 목록">
        <p class="result_count" role="status">Total. <strong>12건</strong></p>
        <ul class="member_grid">
                @for (var i = 0; i < members.Length; i++)
                {
                    var member = members[i];

                    <li class="member_card">
                        <a href="/members/detail" aria-label="@(member.Name) 카드 — 대표 구성원 상세 미리보기">
                            <div class="member_info">
                                <h2>@member.Name</h2>
                                <p>@member.Role</p>
                                <dl>
                                    @if (!string.IsNullOrWhiteSpace(member.Email))
                                    {
                                        <div>
                                            <dt>M.</dt>
                                            <dd>@member.Email</dd>
                                        </div>
                                    }
                                    <div>
                                        <dt>T.</dt>
                                        <dd>@member.Phone</dd>
                                    </div>
                                </dl>
                            </div>
                            <div class="member_portrait">
                                <img src="@member.Image" alt="@(member.Name) 변호사" width="335" height="335" loading="lazy">
                            </div>
                        </a>
                    </li>
                }
            </ul>
        <partial name="Common/_Pagination" />
    </section>
</main>

