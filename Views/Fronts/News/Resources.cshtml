@section css {
    <link rel="stylesheet" href="~/css/pages/news/index.css" asp-append-version="true">
}

<main id="main" class="sub_page static_list_page section">
    <div class="page_heading container-md">
        <nav class="breadcrumb" aria-label="현재 위치">
            <ol>
                <li><a href="/">Home</a></li>
                <li>소식/자료</li>
                <li aria-current="page">자료실</li>
            </ol>
        </nav>
        <h1 class="section_scroll">자료실</h1>
        <p class="section_scroll">주요 법률 이슈와 실무에 필요한 정보를 확인하세요.</p>
    </div>
    <div class="list_search" role="search">
        <label class="search_box">
            <span class="sr_only">게시물을 검색해 주세요.</span>
            <input type="search" name="q" placeholder="게시물을 검색해 주세요.">
            <button type="button" aria-label="검색">
                <i class="svg_icon search_icon">
                    <img src="/images/icon/search_icon.svg" alt="">
                </i>
            </button>
        </label>
    </div>
    <section class="container-md listing_section">
        <nav class="category_tabs" aria-label="분류">
            <button type="button" class="active" aria-pressed="true">전체</button>
            <button type="button" class="" aria-pressed="false">브로슈어</button>
            <button type="button" class="" aria-pressed="false">기고/칼럼</button>
        </nav>
        <p class="result_count" role="status">Total. <strong>9건</strong></p>
        <ul class="resource_grid">
            @for (var i = 0; i < resourceItems.Length; i++)
            {
                var item = resourceItems[i];

                <li class="resource_card">
                    <a href="/news/detail" class="resource_cover">
                        <figure class="resource_img">
                            <img src="@(string.IsNullOrWhiteSpace(item.Image) ? "/images/common/resource_null.png" : item.Image)" alt="@item.ImageAlt" loading="lazy">
                        </figure>
                        <p class="post_title">@item.Title</p>
                        <div class="post_meta">
                            <span class="post_category">@item.Category</span>
                            <time class="post_date">@item.Date</time>
                        </div>
                    </a>
                    <button class="button download_preview" type="button" data-preview="첨부 PDF 원본이 제공되지 않아 다운로드는 연동 전입니다.">
                        파일 다운로드
                        <i class="svg_icon post_download_icon">
                            <img src="/images/icon/post_download_icon.svg" alt="" aria-hidden="true">
                        </i>
                    </button>
                </li>
            }
        </ul>
        <partial name="Common/_Pagination" />
    </section>
</main>