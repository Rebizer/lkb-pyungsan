}

@section headtag {
    @Html.Raw(ViewBag.companymodel.HeadTag)
}

@section headtagnext {
    @Html.Raw(ViewBag.companymodel.HeadNextTag)
}

@section scripttag {
    @Html.Raw(ViewBag.companymodel.ScriptTag)
}

@section css {
    <link rel="stylesheet" href="~/css/pages/news/index.css" asp-append-version="true">
}

<main id="main" class="sub_page static_list_page section">
    <div class="page_heading container-md">
        <nav class="breadcrumb" aria-label="현재 위치">
            <ol>
                <li><a href="/">Home</a></li>
                <li>소식/자료</li>
                <li aria-current="page">법인소식</li>
            </ol>
        </nav>
        <h1 class="section_scroll">법인소식</h1>
        <p class="section_scroll">LKB평산의 새로운 소식과 주요 활동을 전합니다.</p>
    </div>
    <div class="list_search" role="search">
        <label class="search_box">
            <span class="sr_only">게시물을 검색해 주세요.</span>
            <input type="search" name="q" placeholder="게시물을 검색해 주세요.">
            <button type="button" aria-label="검색">
                <i class="svg_icon search_icon">
                    <img src="/images/icon/search_icon.svg" alt="">
                </i>
            </button>
        </label>
    </div>
    <section class="container-md listing_section">
        <nav class="category_tabs" aria-label="분류">
            <button type="button" class="active" aria-pressed="true">전체</button>
            <button type="button" class="" aria-pressed="false">공지사항</button>
            <button type="button" class="" aria-pressed="false">세미나</button>
            <button type="button" class="" aria-pressed="false">위촉업무</button>
        </nav>
        <p class="result_count" role="status">Total. <strong>10건</strong></p>
        <ul class="news_list">
            @for (var i = 0; i < newsItems.Length; i++)
            {
                var item = newsItems[i];

                <li class="news_row">
                    <a href="/news/detail">
                        <p class="post_title">@if(i < 3){<strong>공지</strong>}@item.Title</p>
                        <div class="post_meta">
                            <span class="post_category">@item.Category</span>
                            <time class="post_date">@item.Date</time>
                        </div>
                    </a>
                </li>
            }
        </ul>
        <partial name="Common/_Pagination" />
    </section>
</main>

