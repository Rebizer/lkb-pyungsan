@section meta {
    <title>법인소식 | 법무법인 LKB평산</title>
    <meta name="Title" content="법인소식 | 법무법인 LKB평산">
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="LKB평산의 새로운 소식과 주요 활동을 전합니다.">
    <meta name="application-name" content="법무법인 LKB평산">
    <meta name="robots" content="index,follow">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="법무법인 LKB평산">
    @await Html.PartialAsync("~/Views/Shared/Common/_Schema.cshtml")
}
@section ogtags {
    <meta property="og:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta property="og:locale" content="ko_KR">
    <meta property="og:type" content="website">
    <meta property="og:title" content="법인소식">
    <meta property="og:site_name" content="법무법인 LKB평산">
    <meta property="og:description" content="LKB평산의 새로운 소식과 주요 활동을 전합니다.">
    <meta property="og:url" content="@currentUrl">

    <meta name="twitter:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="법인소식">
    <meta name="twitter:site" content="법무법인 LKB평산">
    <meta name="twitter:description" content="LKB평산의 새로운 소식과 주요 활동을 전합니다.">
