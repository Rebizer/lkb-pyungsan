@section meta {
    <title>미디어 | 법무법인 LKB평산</title>
    <meta name="Title" content="미디어 | 법무법인 LKB평산">
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="언론보도, 유튜브, 블로그로 LKB평산의 소식과 법률 이야기를 만나보세요.">
    <meta name="application-name" content="법무법인 LKB평산">
    <meta name="robots" content="noindex,nofollow" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="법무법인 LKB평산">
    @await Html.PartialAsync("~/Views/Shared/Common/_Schema.cshtml")
}
@section ogtags {
    <meta property="og:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta property="og:locale" content="ko_KR">
    <meta property="og:type" content="website">
    <meta property="og:title" content="미디어">
    <meta property="og:site_name" content="법무법인 LKB평산">
    <meta property="og:description" content="언론보도, 유튜브, 블로그로 LKB평산의 소식과 법률 이야기를 만나보세요.">
    <meta property="og:url" content="@currentUrl">

    <meta name="twitter:image" content="@(realUrl)/images/home/home_hero_bg.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="미디어">
    <meta name="twitter:site" content="법무법인 LKB평산">
    <meta name="twitter:description" content="언론보도, 유튜브, 블로그로 LKB평산의 소식과 법률 이야기를 만나보세요.">
    <meta name="twitter:url" content="@currentUrl">
}

@section headtag {
    @Html.Raw(ViewBag.companymodel.HeadTag)
}

@section headtagnext {
    @Html.Raw(ViewBag.companymodel.HeadNextTag)
}

@section scripttag {
    @Html.Raw(ViewBag.companymodel.ScriptTag)
}

@section css {
    <link rel="stylesheet" href="~/css/pages/news/index.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pages/news/media.css" asp-append-version="true">
}

<main id="main" class="sub_page static_list_page section">
    <div class="page_heading container-md">
        <nav class="breadcrumb" aria-label="현재 위치">
            <ol>
                <li><a href="/">Home</a></li>
                <li>소식/자료</li>
                <li aria-current="page">미디어</li>
            </ol>
        </nav>
        <h1 class="section_scroll">미디어</h1>
        <p class="section_scroll">다양한 미디어로 LKB평산의 소식과 법률 이야기를 만나보세요.</p>
    </div>
    <div class="list_search" role="search">
        <label class="search_box">
            <span class="sr_only">게시물을 검색해 주세요.</span>
            <input type="search" name="q" placeholder="게시물을 검색해 주세요.">
            <button type="button" aria-label="검색">
                <i class="svg_icon search_icon">
                    <img src="/images/icon/search_icon.svg" alt="">
                </i>
            </button>
        </label>
    </div>
    <section class="container-md listing_section">
        <nav class="category_tabs" aria-label="분류">
            <button type="button" class="active" aria-pressed="true">전체</button>
            <button type="button" class="" aria-pressed="false">언론보도</button>
            <button type="button" class="" aria-pressed="false">유튜브</button>
            <button type="button" class="" aria-pressed="false">블로그</button>
        </nav>
        <p class="result_count" role="status">Total. <strong>8건</strong></p>
        <ul class="media_list">
            @for (var i = 0; i < mediaItems.Length; i++)
            {
                var item = mediaItems[i];

                <li class="media_row">
                    <a href="/news/detail">
                        <figure class="media_thumbnail">
                            <img src="@(string.IsNullOrWhiteSpace(item.Image) ? "/images/common/media_null.png" : item.Image)" alt="@item.ImageAlt" loading="lazy">
                        </figure>
                        <div class="post_content">
                            <p class="post_title">@item.Title</p>
                            <div class="post_meta">
                                <span class="post_category">@item.Category</span>
                                <time class="post_date">@item.Date</time>
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>
        <partial name="Common/_Pagination" />
    </section>
</main>
