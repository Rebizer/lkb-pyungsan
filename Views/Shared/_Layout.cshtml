<!DOCTYPE html>
<html lang="ko">
<head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="content-language" content="ko" />

    <meta name="keywords" content="lkb평산" />
    @await RenderSectionAsync("meta", required: true)
    @await RenderSectionAsync("ogtags", required: true)
    @await RenderSectionAsync("headtag", required: false)

    <!-- icon -->
    <link rel="apple-touch-icon" sizes="57x57" href="/apple-icon-57x57.png" />
    <link rel="apple-touch-icon" sizes="60x60" href="/apple-icon-60x60.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/apple-icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-icon-76x76.png" />
    <link rel="apple-touch-icon" sizes="114x114" href="/apple-icon-114x114.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-icon-120x120.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/apple-icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-icon-192x192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="msapplication-TileColor" content="#ffffff" />
    <meta name="msapplication-TileImage" content="/ms-icon-144x144.png" />
    <meta name="theme-color" content="#ffffff" />

    <!-- fonts / css -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@40,400,0,0" />
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard-dynamic-subset.css" />
    <link rel="stylesheet" href="~/css/bundle.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/default.css" asp-append-version="true">
    @await RenderSectionAsync("css", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    @await RenderSectionAsync("headtagnext", required: false)
    @if (ViewData["CenterHeader"] is true)
    {
        @await Html.PartialAsync("~/Views/Shared/Common/_CenterHeaderNavBar.cshtml")
    }
    else
    {
        @await Html.PartialAsync("~/Views/Shared/Common/_HeaderNavBar.cshtml")
    }
    @RenderBody()
    @await Html.PartialAsync("~/Views/Shared/Common/_Footer.cshtml")
    <div class="toast_message" role="status" aria-live="polite"></div>

    <div class="loader_bg" role="status" aria-live="polite" aria-hidden="true">
        <span class="loader" aria-hidden="true"></span>
    </div>


    <script src="~/js/bundle.js" asp-append-version="true"></script>
    <script src="~/js/lenis.js" type="module" asp-append-version="true"></script>
    <script src="~/js/default.js" asp-append-version="true"></script>
    @await RenderSectionAsync("scripts", required: false)
    @await RenderSectionAsync("scripttag", required: false)
    
</body>
</html>
