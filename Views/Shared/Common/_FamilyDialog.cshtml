<dialog id="family_dialog" class="family_dialog" aria-labelledby="family_title" data-lenis-prevent="">
    <div class="family_header">
        <button class="dialog_close" type="button" aria-label="닫기">
            <i class="svg_icon family_close_icon">
                <img src="/images/icon/family_close_icon.svg" alt="" aria-hidden="true">
            </i>
        </button>
        <h2 id="family_title">패밀리사이트</h2>
        <label class="search_box">
            <span class="sr_only">패밀리사이트 검색</span>
            <input class="family_search" placeholder="검색어를 입력해 주세요." type="search">
            <i class="svg_icon search_icon">
                <img src="/images/icon/search_icon.svg" alt="" aria-hidden="true">
            </i>
        </label>
    </div>
    <div class="family_body">
        <p class="family_count" role="status"></p>
        <ul class="family_list">
            @for (var i = 0; i < familySites.Length; i++)
            {
                var item = familySites[i];

                <li>
                    <a href="/center" data-center="@item.DataCenter">
                        @item.Label
                        <span class="family_link_icon">
                            <i class="svg_icon arrow_hover_icon external_link_icon">
                                <img src="/images/icon/external_link_icon.svg" alt="" aria-hidden="true">
                            </i>
                        </span>
                    </a>
                </li>
            }
        </ul>
    </div>
</dialog>
