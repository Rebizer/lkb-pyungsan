<header class="site_header">
    <a class="brand" href="/" aria-label="법무법인 LKB평산 홈">
        <img class="logo_dark" src="/images/brand/lkb_logo_dark.svg" alt="법무법인 LKB평산">
    </a>
    <nav class="desktop_nav" aria-label="주 메뉴">
        <ul>
        @for (var i = 0; i < navigationGroups.Length; i++)
        {
            var group = navigationGroups[i];

            <li>
                <a href="@group.Url">@group.Name</a>
                <ul>
                    @for (var j = 0; j < group.Children.Length; j++)
                    {
                        var link = group.Children[j];

                        <li><a href="@link.Url">@link.Name</a></li>
                    }
                </ul>
            </li>
        }
        </ul>
    </nav>
    <div class="header_tools">
        <button type="button" class="family_button outlined" data-dialog="family_dialog">
            패밀리사이트
            <span class="image_label">
                <i class="svg_icon add_header_icon">
                    <img src="/images/icon/add_header_icon.svg" alt="" aria-hidden="true">
                </i>
            </span>
        </button>
        <div class="language_wrap">
            <button type="button" class="outlined language_toggle" aria-expanded="false" aria-controls="language_list">
                <i class="svg_icon language_icon">
                    <img src="/images/icon/language_icon.svg" alt="">
                </i>
                KO
            </button>
            <ul id="language_list" hidden="">
                @for (var i = 0; i < languages.Length; i++)
                {
                    var item = languages[i];

                    <li>
                        <button type="button" data-preview="@item.DataPreview">@item.Text</button>
                    </li>
                }
            </ul>
        </div>
        <a class="icon_button" href="/search" aria-label="통합검색">
            <i class="svg_icon search_header_icon">
                <img src="/images/icon/search_header_icon.svg" alt="">
            </i>
        </a>
        <button type="button" class="menu_toggle icon_button" aria-controls="menu_dialog" aria-expanded="false" aria-label="전체 메뉴 열기">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</header>
