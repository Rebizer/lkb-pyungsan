        <h2>전화문의</h2>
        <p>아래 연락처로 전화 주시면 상담을 도와드리겠습니다.</p>
        <div class="phone_grid">
            <a href="tel:025828500">웅진관<strong>02-582-8500</strong></a>
            <a href="tel:025967007">정곡관<strong>02-596-7007</strong></a>
        </div>
        <p class="small consult_hours"><strong>상담시간</strong> | 평일 09:00 ~ 18:00 (점심시간 12:00~13:00)</p>
    </div>
</dialog>
@await Html.PartialAsync("~/Views/Shared/Common/_FamilyDialog.cshtml")
<section id="menu_dialog" class="menu_dialog" aria-label="전체 메뉴" hidden data-lenis-prevent="">
    <div class="menu_content">
        <nav aria-label="전체 메뉴">
            <ul class="sitemap_grid">
        @for (var i = 0; i < navigationGroups.Length; i++)
        {
            var group = navigationGroups[i];

            <li>
                <a href="@group.Url">@group.Name</a>
                <ul>
                    @for (var j = 0; j < group.Children.Length; j++)
                    {
                        var link = group.Children[j];

                        <li><a href="@link.Url">@link.Name</a></li>
                    }
                </ul>
            </li>
        }
            </ul>
        </nav>
        <div class="menu_contacts">
            @for (var i = 0; i < menuOffices.Length; i++)
            {
                var office = menuOffices[i];

                <div class="menu_office">
                    <a class="menu_office_link" href="/contact">
                        <h3>@office.Name</h3>
                        <i class="svg_icon arrow_hover_icon office_external_link_icon">
                            <img src="/images/icon/office_external_link_icon.svg" alt="" aria-hidden="true">
                        </i>
                    </a>
                    <a class="menu_office_phone" href="tel:@office.Tel">@office.Phone</a>
                    <p>@office.Address</p>
                </div>
            }
            <div class="menu_channels">
                <ul class="menu_sns">
                    @for (var i = 0; i < menuChannels.Length; i++)
                    {
                        var channel = menuChannels[i];

                        <li>
                            <a href="@channel.Url" target="_blank" rel="noopener noreferrer" aria-label="@(channel.Name) (새 창)">
                                <i class="svg_icon menu_social_icon">
                                    <img src="/images/icon/@channel.Icon" alt="" aria-hidden="true">
                                </i>
                            </a>
                        </li>
                    }
                </ul>
                <a class="menu_kakao" href="http://pf.kakao.com/_xgkxfHn/chat" target="_blank">
                    <i class="svg_icon menu_kakaotalk_icon">
                        <img src="/images/icon/menu_kakaotalk_icon.svg" alt="" aria-hidden="true">
                    </i>
                    카톡문의
                </a>
            </div>
        </div>
    </div>
    <div class="menu_consult">
        <div class="menu_consult_inner">
            <div class="menu_consult_intro">
                <h2>빠른 상담신청</h2>
                <p>복잡한 법률 문제에 대해 LKB평산의 전문변호사가
                    명확한 해결 방향을 제시합니다.</p>
            </div>
            <form class="menu_consult_form" novalidate>
                <div class="menu_consult_fields">
                    <label class="sr_only" for="menu_name">성함</label>
                    <input id="menu_name" name="name" placeholder="성함" autocomplete="name" required>
                    <label class="sr_only" for="menu_phone">연락처</label>
                    <input id="menu_phone" name="phone" placeholder="연락처" type="tel" autocomplete="tel" inputmode="tel" maxlength="20" required>
                    <button type="submit">상담 신청</button>
                </div>
                <div class="menu_consent">
                    <label class="checkbox_label">
                        <input class="checkbox_input" type="checkbox" name="consent" required>
                        <span><strong>개인정보 수집 및 이용</strong>에 동의합니다.</span>
                    </label>
                    <a href="/policy/privacy" target="_blank" rel="noopener noreferrer">전문보기</a>
                </div>
            </form>
        </div>
    </div>
</section>
<dialog id="filter_dialog" class="filter_dialog" aria-labelledby="filter_title" aria-describedby="filter_description" data-lenis-prevent="">
    <div class="filter_header">
        <h2 id="filter_title">업무분야 선택</h2>
        <p id="filter_description">업무분야를 선택해 해당 분야의 구성원을 찾아보세요. 여러 분야를 선택할 수 있습니다.</p>
        <button type="button" class="dialog_close" aria-label="업무분야 선택 닫기">
            <i class="svg_icon filter_close_icon">
                <img src="/images/icon/family_close_icon.svg" alt="">
            </i>
        </button>
    </div>
    <div class="filter_body">
        <div class="filter_toolbar">
            <p class="filter_count" role="status">선택 분야 <span>0개</span></p>
            <button type="button" class="filter_clear">
                초기화
                <i class="svg_icon reset_icon">
                    <img src="/images/icon/reset_icon.svg" alt="">
                </i>
            </button>
        </div>
        <div class="filter_options" role="group" aria-label="선택 가능한 업무분야">
            @for (var i = 0; i < practiceFilters.Length; i++)
            {
                <label class="filter_option">
                    <input type="checkbox" value="@practiceFilters[i]">
                    <span>@practiceFilters[i]</span>
                </label>
            }
        </div>
    </div>
    <div class="filter_actions">
        <button type="button" class="filter_apply">0개 분야 적용하기</button>
    </div>
</dialog>

