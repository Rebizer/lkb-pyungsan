<footer class="site_footer">
    <div class="footer_inner">
        <div class="footer_heading">
            <a href="/">법무법인(유한) LKB평산</a>
            <nav aria-label="법적 고지">
                <a href="/policy/privacy">개인정보 처리방침</a>
                <a href="/policy/agree">이용약관</a>
                <a href="/policy/disclaimer">면책공고</a>
            </nav>
        </div>
        <div class="office_grid">
            @for (var i = 0; i < offices.Length; i++)
            {
                var office = offices[i];

                <address>
                    <h2>@office.Name</h2>
                    <p><span class="footer_label">사업자등록번호</span> @(office.Registration.Replace("사업자등록번호", "").Trim())</p>
                    <p><span class="footer_label">대표번호</span> <a href="@office.PhoneUrl">@office.Phone</a></p>
                    <p><span class="footer_label">주소</span> @(office.Address.Replace("주소", "").Trim())</p>
                    <p><span class="footer_label">광고책임변호사</span> @(office.ResponsibleLawyer.Replace("광고책임변호사", "").Trim())</p>
                </address>
            }
        </div>
        <p><span class="footer_label">대표변호사</span> 윤웅걸, 김병현</p>
        <p class="copyright">COPYRIGHT © L.K.B 평산 LLC. ALL RIGHTS RESERVED. <a href="https://www.bizer.co.kr/" target="_blank">Created by RE:BIZER</a> </p>
        <div class="footer_bottom">
            <div class="social_links">
                @for (var i = 0; i < socialLinks.Length; i++)
                {
                    var item = socialLinks[i];

                    <a href="@item.Url" target="_blank" rel="noopener noreferrer" aria-label="@(item.Label) (새 창)">
                        <i class="svg_icon footer_social_icon">
                            <img src="@item.Image" alt="">
                        </i>
                    </a>
                }
            </div>
            <button type="button" class="outlined" data-dialog="family_dialog">
                패밀리 사이트
                <span class="image_label">
                    <i class="svg_icon add_footer_icon">
                        <img src="/images/icon/add_footer_icon.svg" alt="" aria-hidden="true">
                    </i>
                </span>
            </button>
        </div>
    </div>
</footer>
